<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait-specific menu layout: 2 columns instead of 7 so buttons are
     wide enough to show their text labels on a narrow screen. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menusview"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:useDefaultMargins="false">

        <CheckBox
            android:id="@+id/systemui"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:text="@string/system_ui" />
        <CheckBox
            android:id="@+id/menus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:checked="true"
            android:text="@string/menus" />

        <Button
            android:id="@+id/watch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:text="@string/watches" />
        <Button
            android:id="@+id/sensor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:text="@string/sensor" />

        <Button
            android:id="@+id/settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:text="@string/settings" />
        <Button
            android:id="@+id/about"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:text="@string/aboutname" />

        <Button
            android:id="@+id/export"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:text="@string/export" />
        <Button
            android:id="@+id/mirror"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:text="@string/mirror" />

        <Button
            android:id="@+id/newamount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:text="@string/new_amount" />
        <Button
            android:id="@+id/list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:text="@string/list" />

        <Button
            android:id="@+id/statistics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:text="@string/statistics" />
        <Button
            android:id="@+id/talk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:text="@string/talk" />

        <Button
            android:id="@+id/lastscan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:text="@string/last_scan" />
        <Button
            android:id="@+id/now"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:text="@string/now" />

        <Button
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:text="@string/search" />
        <Button
            android:id="@+id/date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:text="@string/date" />

        <Button
            android:id="@+id/dayback"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:text="@string/day_back" />
        <Button
            android:id="@+id/daylater"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:text="@string/day_later" />

        <Button
            android:id="@+id/weekback"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:text="@string/week_back" />
        <Button
            android:id="@+id/weeklater"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:text="@string/week_later" />

        <CheckBox
            android:id="@+id/glucosefloat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:text="@string/floatname" />
        <Button
            android:id="@+id/close"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:text="@string/closename" />

        <CheckBox
            android:id="@+id/scans"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:text="@string/scansname" />
        <CheckBox
            android:id="@+id/calibratedscans"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:text="" />

        <CheckBox
            android:id="@+id/stream"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:text="@string/streamname" />
        <CheckBox
            android:id="@+id/calibratedstream"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:text="" />

        <CheckBox
            android:id="@+id/history"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:text="@string/historyname" />
        <CheckBox
            android:id="@+id/calibratedhistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:text="" />

        <CheckBox
            android:id="@+id/amounts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:text="@string/amountsname" />
        <CheckBox
            android:id="@+id/meals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:text="@string/mealsname" />

        <CheckBox
            android:id="@+id/darkmode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_columnSpan="2"
            android:layout_columnWeight="1"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:text="@string/darkmode" />

    </GridLayout>

</ScrollView>
